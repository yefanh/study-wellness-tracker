generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// All timestamps are `timestamptz`: Postgres stores an absolute instant (UTC) and
// converts with AT TIME ZONE when we group records by the user's local day.

model User {
  id            String         @id @default(uuid()) @db.Uuid
  email         String         @unique
  name          String?
  /// IANA time zone that decides which calendar day a record belongs to.
  timezone      String         @default("America/New_York")
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  studySessions StudySession[]
  breaks        Break[]
  moodLogs      MoodLog[]
  habits        Habit[]
  checkIns      HabitCheckIn[]
}

/// A focus block. `endedAt` is null while the session is running.
/// migration.sql adds a partial unique index: at most one running session per user.
model StudySession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt DateTime  @default(now()) @db.Timestamptz(3)
  endedAt   DateTime? @db.Timestamptz(3)
  focusArea String?

  @@index([userId, startedAt])
}

/// A break is logged after it happens, so it always has both ends.
model Break {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt DateTime  @db.Timestamptz(3)
  endedAt   DateTime  @db.Timestamptz(3)
  type      BreakType
  notes     String?

  @@index([userId, startedAt])
}

/// migration.sql adds CHECK constraints: every score is between 1 and 5.
model MoodLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recordedAt DateTime @default(now()) @db.Timestamptz(3)
  mood       Int      @db.SmallInt
  energy     Int?     @db.SmallInt
  stress     Int?     @db.SmallInt
  notes      String?

  @@index([userId, recordedAt])
}

model Habit {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @db.Uuid
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  targetPerWeek Int            @default(7) @db.SmallInt
  archived      Boolean        @default(false)
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  checkIns      HabitCheckIn[]

  @@unique([userId, name])
}

/// One row per habit per local day, so checking in twice is a no-op (idempotent).
model HabitCheckIn {
  id          String   @id @default(uuid()) @db.Uuid
  habitId     String   @db.Uuid
  habit       Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day         DateTime @db.Date
  completedAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([habitId, day])
  @@index([userId, day])
}

enum BreakType {
  SHORT
  LONG
  MOVEMENT
  MEAL
  OTHER
}
