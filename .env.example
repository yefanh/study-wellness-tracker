# Local dev database (started by `make db`, see docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5440/study_wellness_tracker?schema=public"

# Separate databases so tests never touch your dev data
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5440/study_wellness_test?schema=public"
E2E_DATABASE_URL="postgresql://postgres:postgres@localhost:5440/study_wellness_e2e?schema=public"

# The app has no login: every request acts as this demo user
DEMO_USER_EMAIL="demo@studywellness.local"
